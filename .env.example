# 服务器配置
PORT=3000
HOST=0.0.0.0

# Nexos.ai Cookies (必填)
# 1. 在浏览器中打开 nexos.ai 并登录
# 2. 打开开发者工具 (F12)
# 3. 进入 Network 标签
# 4. 发送一条消息
# 5. 找到请求，右键 -> Copy -> Copy as cURL
# 6. 从 cURL 命令中复制 -b 后面的所有 cookie 内容

# 方式一：多账号 Cookie 池（推荐，支持 round-robin 轮询）
NEXOS_COOKIES_1='cookie_string_for_account_1'
NEXOS_COOKIES_2='cookie_string_for_account_2'
# NEXOS_COOKIES_3='cookie_string_for_account_3'

# 方式二：向下兼容单 Cookie
# NEXOS_COOKIES='your-cookies-here'

# ── Cookie 存储后端 ──────────────────────────────────
# COOKIE_STORE_BACKEND=sqlite   # 默认，零依赖
# COOKIE_STORE_BACKEND=redis    # 高并发/多进程场景

# SQLite 后端（默认）
# COOKIE_DB_PATH=cookies.db

# Redis 后端（需要 pip install redis）
# REDIS_URL=redis://localhost:6379/0

# Cookie 连续失败超过此次数后自动停用
# COOKIE_MAX_FAIL_COUNT=5

# 注意：Chat ID 通过 current-chat.json 文件管理，不需要在这里配置
# 启动服务器后，调用 POST /v1/chat/create 创建新对话
# Chat ID 会自动保存在 current-chat.json 文件中
