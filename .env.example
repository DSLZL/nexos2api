# 服务器配置
PORT=3000
HOST=0.0.0.0

# Nexos.ai Cookies (必填)
# 1. 在浏览器中打开 nexos.ai 并登录
# 2. 打开开发者工具 (F12)
# 3. 进入 Network 标签
# 4. 发送一条消息
# 5. 找到请求，右键 -> Copy -> Copy as cURL
# 6. 从 cURL 命令中复制 -b 后面的所有 cookie 内容

# 方式一：多账号 Cookie 池（推荐，支持 round-robin 轮询）
NEXOS_COOKIES_1='cookie_string_for_account_1'
NEXOS_COOKIES_2='cookie_string_for_account_2'
# NEXOS_COOKIES_3='cookie_string_for_account_3'

# 方式二：向下兼容单 Cookie
# NEXOS_COOKIES='your-cookies-here'

# ── Cookie 存储后端 ──────────────────────────────────
# COOKIE_STORE_BACKEND=sqlite   # 默认，零依赖
# COOKIE_STORE_BACKEND=redis    # 高并发/多进程场景

# SQLite 后端（默认）
# COOKIE_DB_PATH=cookies.db

# Redis 后端（需要 pip install redis）
# REDIS_URL=redis://localhost:6379/0

# Cookie 连续失败超过此次数后自动停用
# COOKIE_MAX_FAIL_COUNT=5

# Cookie 失败后冷却秒数（冷却期内不参与轮询）
# COOKIE_COOLDOWN_SECONDS=60

# Cookie 轮询策略：round-robin（简单轮询）/ weighted（优先级+最久未用，默认）/ least-used（最少使用优先）
# COOKIE_ROTATION_STRATEGY=weighted

# Cookie 健康检查间隔（秒）
# COOKIE_HEALTH_CHECK_INTERVAL=300

# 是否自动恢复停用的 Cookie（健康检查通过时重新启用）
# COOKIE_AUTO_RECOVER=false

# 注意：Chat ID 通过 current-chat.json 文件管理，不需要在这里配置
# 启动服务器后，调用 POST /v1/chat/create 创建新对话
# Chat ID 会自动保存在 current-chat.json 文件中

# ── 出口代理（可选）────────────────────────────────────
# 支持 HTTP/HTTPS 代理和 SOCKS5 代理（SOCKS 需要 httpx[socks]，已内置依赖）
# PROXY_URL=http://127.0.0.1:7890
# PROXY_URL=socks5://127.0.0.1:1080
# PROXY_URL=socks5h://user:pass@127.0.0.1:1080

# ── SSL 验证（可选）─────────────────────────────────────
# 默认 true（推荐）；仅受信内网/自签证书环境可设为 false
# NEXOS_VERIFY_SSL=true

# ── 管理界面访问控制（可选）─────────────────────────────
# 设置后，所有 /admin/* 接口和页面需要 Authorization: Bearer <密码>
# 留空则不需要认证（适合本地/内网部署）
# ADMIN_PASSWORD=

# ── 请求日志（可选）─────────────────────────────────────
# ENABLE_REQUEST_LOGGING=true
# LOG_RETENTION_DAYS=7
